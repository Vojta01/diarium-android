<?xml version="1.0" encoding="utf-8"?>
<!--
  Android Auto Backup and device-transfer rules for API 31+.

  Keep Android's default backup scope: there are no include allow-lists, so the
  user's existing backup settings continue to govern ordinary data. Local drafts,
  unsynced diary saves, profile data, photo candidates, and cached entries stay
  eligible for cloud backup and device transfer. The same credential stores are
  excluded in both destinations: AiKeyStore (user AI key), SessionStore (Supabase
  JWTs), EncryptedOAuthAttemptStore (PKCE verifier),
  PushTokensRepository.PrefsLastTokenStore (FCM token), and the Firebase SDK's
  `com.google.android.gms.appid` installation/token state.

  These rules govern future backup/restore and do not erase local data or an
  existing cloud backup.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="diarium_ai_secrets.xml" />
        <exclude domain="sharedpref" path="diarium_session.xml" />
        <exclude domain="sharedpref" path="diarium_oauth_attempt.xml" />
        <exclude domain="sharedpref" path="diarium_fcm.xml" />
        <exclude domain="sharedpref" path="com.google.android.gms.appid.xml" />
    </cloud-backup>

    <device-transfer>
        <exclude domain="sharedpref" path="diarium_ai_secrets.xml" />
        <exclude domain="sharedpref" path="diarium_session.xml" />
        <exclude domain="sharedpref" path="diarium_oauth_attempt.xml" />
        <exclude domain="sharedpref" path="diarium_fcm.xml" />
        <exclude domain="sharedpref" path="com.google.android.gms.appid.xml" />
    </device-transfer>
</data-extraction-rules>
